{
  "manifest_version": 3,
  "name": "YouTube Customizer",
  "version": "1.1",
  "description": "Play YouTube videos in HD, cinematic mode, and custom speed.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.youtube.com/embed/*"
      ],
      "js": ["content.js"]
    }
  ]
}